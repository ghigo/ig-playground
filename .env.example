# Instagram Credentials
# IG_USERNAME: Your login username (can be email or username)
IG_USERNAME=your_instagram_username
IG_PASSWORD=your_instagram_password

# Optional: Your Instagram handle (only needed if you login with email)
# If you login with email, the script will auto-detect your handle
# But you can specify it here to skip auto-detection
# IG_HANDLE=your_instagram_handle

# Output Format: 'csv' or 'google-sheets'
# csv: Saves to a local CSV file in the 'output' folder (RECOMMENDED FOR QUICK START)
# google-sheets: Saves to Google Sheets (requires additional setup)
OUTPUT_FORMAT=csv

# Google Sheets Configuration (only needed if OUTPUT_FORMAT=google-sheets)
GOOGLE_SHEET_ID=your_google_sheet_id
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./service-account-key.json

# Optional: Set to 'true' to run in headless mode (no browser window)
HEADLESS=false

# Optional: Delay between profile scrapes (in milliseconds) to avoid rate limiting
SCRAPE_DELAY=3000

# Cache Duration: Number of days before re-fetching profile data
# If profile data was fetched within this many days, it will be reused
# Set to 0 to always fetch fresh data
CACHE_DAYS=10
